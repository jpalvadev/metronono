{
  "name": "metronono",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "node scripts/one-style.mjs && tsc --noEmit && vitest run",
    "check:style": "node scripts/one-style.mjs",
    "check:tokens": "node scripts/one-style.mjs --audit",
    "check:live": "node scripts/live-audio-guard.mjs",
    "cap:sync": "cap sync",
    "cap:build:android": "vite build && cap sync android",
    "build:apk": "npm run cap:build:android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@vexflow-fonts/bravura": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.0.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
